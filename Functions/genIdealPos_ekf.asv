function [x_ideal, y_ideal, z_ideal, a_ideal, w_ideal,w_dot_ideal, wheel_control] = genIdealPos_ekf(vMax,f, p0, geo_vars, revols)

x_0 = p0(1);
y_0 = p0(2);
z_0 = p0(3);
a_0 = p0(4);
w_0 = p0(5);
w_dot_0 = p0(6);

r_p = geo_vars(1);
b = geo_vars(2);

dt = 1/f;




circum = 2*pi*r_p;

t_rev = circum/vMax;

wheel_control = [0 0];


% x_dot = @(vl, vr, a, w,dt) (vr/2 + vl/2)*sin(a)*cos(w)*dt;
% y_dot = @(vl, vr, a,dt) (vr/2 + vl/2)*cos(a)*dt;
% z_dot = @(vl, vr, a, w,dt) -(vr/2 + vl/2)*sin(a)*sin(w)*dt;
% a_dot = @(vl, vr,dt) (1/b)*(vr - vl)*dt;
% w_dot = @(vl, vr, a,dt) (vr/2 + vl/2)*sin(a)*dt/r_p;

% x_dot = @(R,w__dot) R*sin(w__dot);
% y_dot = @(vl, vr, a,dt) (vr/2 + vl/2)*cos(a)*dt;
% z_dot = @(R,w__dot) -R*sin(w__dot);
% a_dot = @(vl, vr,dt) (1/b)*(vr - vl)*dt;
% w_dot = @(vl, vr, a,dt) (vr/2 + vl/2)*sin(a)*dt/r_p;

y_dot = @(vl, vr, a,dt) (vr/2 + vl/2)*cos(a)*dt;
a_dot = @(vl, vr,dt) (1/b)*(vr - vl)*dt;
w_dot = @(vl, vr, a,dt) (vr/2 + vl/2)*sin(a)*dt/r_p;


count = 1;
for t = 1:revols*t_rev*f-1
   
    wheel_control(count,:) = [vMax vMax];
    count = count + 1;
end

% figure
% hold on

x_ideal = zeros(1,length(wheel_control))';
y_ideal = zeros(1,length(wheel_control))';
z_ideal = zeros(1,length(wheel_control))';
a_ideal = zeros(1,length(wheel_control))';
w_ideal = zeros(1,length(wheel_control))';
w_dot_ideal = zeros(1,length(wheel_control))';

x_ideal(1) = x_0;
y_ideal(1) = y_0;
z_ideal(1) = z_0;

a_ideal(1) = a_0;
w_ideal(1) = w_0;
w_dot_ideal(1) = 

for i = 2:length(wheel_control)
    
      
     vr = wheel_control(i-1,1);
     vl = wheel_control(i-1,2);
     
    da = a_dot(vr, vl, dt);
    dw = w_dot(vr, vl, a_ideal(i-1),dt);
    dy = y_dot(vr, vl, a_ideal(i-1),dt);
    
    
    x_ideal(i) =  r_p*sin(w_ideal(i-1)+w_dot_ideal(i-1));
    y_ideal(i) =  y_ideal(i-1) + dy;
    z_ideal(i) =  r_p*cos(w_ideal(i-1)+w_dot_ideal(i-1));
    a_ideal(i) =  a_ideal(i-1) + da;
    w_ideal(i) =  w_ideal(i-1) + w_dot_ideal(i-1);
    w_dot_ideal(i) = dw;
     
end


end